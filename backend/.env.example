APP_NAME=NexPanel
DEBUG=false
SECRET_KEY=change-me-use-openssl-rand-hex-32

DATABASE_URL=sqlite+aiosqlite:///./vps_panel.db

JWT_SECRET_KEY=change-me-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_NETWORK=vps-network
DOCKER_SUBNET=172.20.0.0/16
DOCKER_DATA_DIR=/var/lib/nexpanel/data

IP_POOL_SUBNET=10.0.0.0/24
IP_POOL_GATEWAY=10.0.0.1
IP_POOL_DNS=8.8.8.8,8.8.4.4

TAILSCALE_AUTH_KEY=tskey-auth-...
TAILSCALE_API_KEY=tskey-api-...

TMATE_SERVER=tmate.io

DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_WEBHOOK_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@vpspanel.local

BRAND_NAME=NexPanel
BRAND_COLOR=#3b82f6

MAX_VPS_PER_USER=10
MAX_CPU_CORES=8
MAX_RAM_GB=32
MAX_DISK_GB=500

ADMIN_API_KEY=
