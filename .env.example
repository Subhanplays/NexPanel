# =============================================================================
# NexPanel - Environment Configuration
# =============================================================================
# Copy this file to .env and customize the values.
# Generated secrets will be filled by the installer for fresh installations.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=NexPanel
APP_URL=http://localhost:8000
SECRET_KEY=change-me-use-openssl-rand-hex-32
DEBUG=false

# --- Database ----------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/panel.db
DB_ECHO=false

# --- JWT Authentication ------------------------------------------------------
JWT_SECRET_KEY=change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Admin Account -----------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# --- Docker ------------------------------------------------------------------
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_TLS_VERIFY=false
DOCKER_CERT_PATH=
DOCKER_API_VERSION=auto
DOCKER_NETWORK=vps-network
DOCKER_SUBNET=172.20.0.0/16
DOCKER_DATA_DIR=/var/lib/vps-panel/data
DOCKER_IMAGE_BUILD_TIMEOUT=600
DOCKER_CONTAINER_START_TIMEOUT=120
MAX_CONTAINERS=100

# --- Default VPS Resources --------------------------------------------------
DEFAULT_CPU_CORES=1
DEFAULT_RAM_GB=1
DEFAULT_DISK_GB=20
MAX_CPU_CORES=8
MAX_RAM_GB=32
MAX_DISK_GB=500
MAX_VPS_PER_USER=3

# --- Default OS Image --------------------------------------------------------
DEFAULT_OS_IMAGE=ubuntu:22.04

# --- IP Pool -----------------------------------------------------------------
IP_POOL_SUBNET=10.0.0.0/24
IP_POOL_GATEWAY=10.0.0.1
IP_POOL_DNS=8.8.8.8,8.8.4.4
IP_POOL_INTERFACE=eth0

# --- Tailscale ----------------------------------------------------------------
TAILSCALE_AUTH_KEY=
TAILSCALE_API_KEY=
TAILSCALE_NETWORK=100.64.0.0/10
TAILSCALE_TIMEOUT=30
TAILSCALE_INSTALL=true

# --- tmate -------------------------------------------------------------------
TMATE_ENABLED=true
TMATE_SERVER=tmate.io
TMATE_TIMEOUT=30

# --- SSHX --------------------------------------------------------------------
SSHX_ENABLED=true
SSHX_SERVER=
SSHX_TIMEOUT=30

# --- Discord Bot (optional) --------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_WEBHOOK_URL=
DISCORD_ADMIN_IDS=
DISCORD_ADMIN_ROLE_ID=
BOT_API_KEY=

# --- SMTP (optional) ---------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@vpspanel.local

# --- API Security ------------------------------------------------------------
ADMIN_API_KEY=
RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT=100
API_KEY_HEADER=X-API-Key

# --- CORS --------------------------------------------------------------------
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# --- Audit Logging -----------------------------------------------------------
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=90

# --- Monitoring --------------------------------------------------------------
MONITORING_INTERVAL=60
ANTI_MINER_ENABLED=true
ANTI_MINER_CHECK_INTERVAL=300

# --- Branding ----------------------------------------------------------------
BRAND_NAME=NexPanel
BRAND_LOGO_URL=
BRAND_COLOR=#6366f1
BRAND_FOOTER=Powered by NexPanel
BRANDING_NAME=NexPanel
BRANDING_DESCRIPTION=Self-hosted VPS management platform
BRANDING_PRIMARY_COLOR=#6366f1
BRANDING_SECONDARY_COLOR=#1a1a2e
